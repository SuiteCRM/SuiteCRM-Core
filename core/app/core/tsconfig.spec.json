/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    // Angular emits its own DI metadata; TypeScript's runtime metadata causes circular imports in Karma.
    "emitDecoratorMetadata": false,
    "outDir": "../../../out-tsc/spec",
    "types": [
      "jasmine"
    ],
    "paths": {
      "core": [
        "dist/core"
      ]
    }
  },
  "files": [
    "src/test.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ]
}
